# Alpaca (paper and live accounts have different keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# CCXT exchanges: <EXCHANGE>_API_KEY / <EXCHANGE>_SECRET (/ <EXCHANGE>_PASSWORD for OKX)
BINANCE_API_KEY=
BINANCE_SECRET=
# OKX_API_KEY=
# OKX_SECRET=
# OKX_PASSWORD=

# Dashboard: required when serving on anything other than localhost (16+ chars)
QUANTDECK_TOKEN=

# Notifications (any you set are used)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_KIND=wecom     # slack | discord | wecom | feishu | dingtalk | generic
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_EMAIL_TO=me@example.com

# News (quantdeck news ...). Every one is optional; sources without a key are skipped with an error in the log.
# ANTHROPIC_API_KEY=            # LLM scoring with Claude
